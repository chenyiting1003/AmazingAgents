# ===== LLM API Configuration =====
# This project uses an OpenAI-compatible API.
#
# Examples:
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
#
# DashScope compatible mode:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus
#
# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

LLM_API_KEY=PASTE_YOUR_API_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Optional Zep Memory Configuration =====
# MiroFish may use Zep for memory / GraphRAG.
# For classroom use, the system should either:
# 1. work with a student-provided Zep key, OR
# 2. gracefully fall back to a reduced-memory mode.
ZEP_API_KEY=PASTE_YOUR_ZEP_KEY_HERE

# ===== Classroom Mode Limits =====
CLASSROOM_MODE=true
MAX_AGENTS=5
MAX_ROUNDS=3
MAX_SEED_WORDS=1000
MAX_REPORT_WORDS=800
MAX_OUTPUT_TOKENS_PER_CALL=800
TEMPERATURE=0.4

# ===== Safety / Logging =====
LOG_LEVEL=INFO
DO_NOT_LOG_KEYS=true
