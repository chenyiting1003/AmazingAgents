# ===== LLM API configuration =====
# Course default: DeepSeek (OpenAI-compatible HTTP API). OpenAI or other compatible vendors optional.
#
# --- DeepSeek (default, recommended) ---
# API key: https://platform.deepseek.com/api_keys
# Docs: https://api-docs.deepseek.com/
# Do not add a /v1 suffix to base_url (SDK requests /chat/completions).
#
LLM_API_KEY=PASTE_YOUR_API_KEY_HERE
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
#
# Other DeepSeek model ids per your dashboard, e.g. (when enabled):
# LLM_MODEL_NAME=deepseek-v4-flash
# LLM_MODEL_NAME=deepseek-v4-pro
#
# --- OpenAI (alternative) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-5
#
# --- DashScope compatible mode (alternative) ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# ===== Optional Zep memory configuration =====
# MiroFish may use Zep for memory / GraphRAG.
# For classroom use, the system should either:
# 1. work with a student-provided Zep key, OR
# 2. gracefully fall back to a reduced-memory mode.
ZEP_API_KEY=PASTE_YOUR_ZEP_KEY_HERE

# ===== Classroom mode limits =====
CLASSROOM_MODE=true
MAX_AGENTS=5
MAX_ROUNDS=3
MAX_SEED_WORDS=1000
MAX_REPORT_WORDS=800
MAX_OUTPUT_TOKENS_PER_CALL=800
# Browser “Continue discussion”: one API call per selected delegate; per-delegate output token cap
MAX_CONTINUE_TOKENS_PER_AGENT=1200
# Deprecated (older single-JSON path); harmless to keep; MAX_CONTINUE_TOKENS_PER_AGENT is authoritative
MAX_CONTINUE_TOKENS=4096
TEMPERATURE=0.4

# ===== Safety / logging =====
LOG_LEVEL=INFO
DO_NOT_LOG_KEYS=true
